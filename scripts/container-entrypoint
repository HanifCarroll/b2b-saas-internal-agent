#!/usr/bin/env bash
set -eu

cleanup() {
  kill "$api_pid" "$web_pid" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

cd /app/backend
uvicorn switchboard.api:app --host 0.0.0.0 --port 8000 &
api_pid=$!

cd /app/frontend
HOSTNAME=0.0.0.0 PORT=3000 node server.js &
web_pid=$!

wait -n "$api_pid" "$web_pid"
