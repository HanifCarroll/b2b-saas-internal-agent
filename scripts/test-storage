#!/usr/bin/env bash
set -euo pipefail

repository="$(cd "$(dirname "$0")/.." && pwd)"
state="$(mktemp -d)"
log="$(mktemp)"
worker_pid=""
port=8799
token=storage-test

cleanup() {
  [[ -z "$worker_pid" ]] || kill "$worker_pid" 2>/dev/null || true
  rm -rf "$state" "$log"
}
trap cleanup EXIT INT TERM

start_worker() {
  (
    cd "$repository/cloudflare"
    exec ./node_modules/.bin/wrangler dev --local \
      --config wrangler.storage.jsonc \
      --persist-to "$state" \
      --port "$port" \
      --var "LOCAL_STORAGE_BRIDGE_TOKEN:$token"
  ) >"$log" 2>&1 &
  worker_pid=$!

  for _ in {1..100}; do
    if curl --silent --output /dev/null "http://127.0.0.1:$port"; then
      return
    fi
    if ! kill -0 "$worker_pid" 2>/dev/null; then
      cat "$log"
      exit 1
    fi
    sleep 0.1
  done
  cat "$log"
  exit 1
}

cd "$repository/cloudflare"
./node_modules/.bin/wrangler d1 migrations apply switchboard \
  --local --persist-to "$state" --config wrangler.storage.jsonc

start_worker
LOCAL_STORAGE_BRIDGE_TOKEN="$token" \
  STORAGE_TEST_URL="http://127.0.0.1:$port" \
  node scripts/verify-storage.mjs prepare

kill "$worker_pid"
wait "$worker_pid" 2>/dev/null || true
worker_pid=""

start_worker
LOCAL_STORAGE_BRIDGE_TOKEN="$token" \
  STORAGE_TEST_URL="http://127.0.0.1:$port" \
  node scripts/verify-storage.mjs retry
