{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "switchboard",
  "account_id": "38d9d25d890a220fb7cf6dd92f8a322a",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "SwitchboardContainer",
      "image": "../Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SWITCHBOARD_CONTAINER",
        "class_name": "SwitchboardContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SwitchboardContainer"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "switchboard",
      "database_id": "849415ed-6263-4843-a1bf-df40190604e2",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "SWITCHBOARD_AUTH_MODE": "demo",
    "NEXT_PUBLIC_AUTH_MODE": "demo",
    "STORAGE_BRIDGE_URL": "http://switchboard.storage"
  }
}
